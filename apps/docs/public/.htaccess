# Apache / LiteSpeed (Hostinger). Vite copies this file into dist on every build.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # The site opens on the Overview.
  RewriteRule ^$ /docs/ [L,R=301]
  # Prerendered pages exist as folder/index.html; the host adds the trailing slash, which matches the canonical URLs.
</IfModule>

# Any other address is a real 404 for crawlers, served with the app shell (noindex) so people still get the site.
ErrorDocument 404 /index.html

AddType text/markdown .md
AddType text/plain .txt
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/markdown application/javascript application/json image/svg+xml application/xml
</IfModule>
